# Supabase — used by the waitlist form (server-side only).
# Reuse the ProdCollab desktop app's Supabase project, or create a new one,
# then run supabase/waitlist.sql against it.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://prodcollab.app
